# --- Salesforce Connected App (OAuth 2.0 Client Credentials flow) ---
# Your My Domain login URL, e.g. https://your-domain.my.salesforce.com
# (Client Credentials flow requires a My Domain; do NOT use login.salesforce.com here.)
SF_LOGIN_URL=https://your-domain.my.salesforce.com

# Consumer Key / Consumer Secret from the Connected App ("Manage Consumer Details")
SF_CLIENT_ID=
SF_CLIENT_SECRET=

# Salesforce REST API version (no leading "v")
SF_API_VERSION=60.0

# --- BigQuery REST API (scripts/bq-query.mjs, used by the weekly-sales-digest agent) ---
# Auth: set ONE of the following (first match wins).
#   1. A pre-minted OAuth2 access token:
BQ_ACCESS_TOKEN=
#   2. A service-account key — path to the JSON file:
GOOGLE_APPLICATION_CREDENTIALS=
#      ...or the JSON key inline (single line):
GCP_SERVICE_ACCOUNT_KEY=
# Billing/run project (default prism-sg-datahub), dataset location, and OAuth scope.
BQ_PROJECT_ID=prism-sg-datahub
BQ_LOCATION=
BQ_SCOPE=https://www.googleapis.com/auth/bigquery

# --- MCP HTTP server ---
PORT=3000

# Optional shared bearer token. If set, every request to /mcp must send
# "Authorization: Bearer <this value>". Leave empty to disable (not recommended
# for a publicly reachable deployment).
MCP_AUTH_TOKEN=
